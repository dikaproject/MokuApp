import { Cfg } from "cfg.slint";
import { Theme } from "theme.slint";
import { ClaudeSection } from "pages-g.slint";
import { Page, Card, Setting, ToggleSetting, Toggle, Segmented, SectionLabel, Btn, Field, Stepper, Glyph, IconTile, Badge } from "widgets.slint";
import { JSettings } from "pages-j.slint";
import { PowerSettings } from "pages-h.slint";
import { IbadahSettings } from "pages-n.slint";
import { AgentsSection, MirrorSection } from "pages-q.slint";
import { PSettings } from "pages-p.slint";
import { PhoneSettings } from "pages-r.slint";

// ---------------------------------------------------------------- Fitur

component FeatureTile inherits Rectangle {
    in property <string> glyph;
    in property <color> tint;
    in property <string> title;
    in property <string> subtitle;
    in property <bool> checked;
    in property <bool> soon: false;
    callback toggled(bool);
    min-height: 60px;
    background: Theme.card;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.line;
    opacity: root.soon ? 0.6 : 1.0;
    HorizontalLayout {
        padding: 12px;
        spacing: 11px;
        VerticalLayout {
            alignment: center;
            IconTile { glyph: root.glyph; tint: root.tint; size: 34px; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: root.title; font-size: 13px; font-weight: 600; color: Theme.text; overflow: elide; }
            Text { text: root.subtitle; font-size: 11px; color: Theme.text3; overflow: elide; }
        }
        VerticalLayout {
            alignment: center;
            if !root.soon: Toggle {
                checked: root.checked;
                toggled(v) => { root.toggled(v); }
            }
            if root.soon: Badge { text: "segera"; }
        }
    }
}

export component FiturPage inherits Page {
    title: "Fitur";
    subtitle: "Nyalakan hanya yang kamu pakai. Fitur yang mati tidak memakan memori.";

    GridLayout {
        spacing: 10px;
