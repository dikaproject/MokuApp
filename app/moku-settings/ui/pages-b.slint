                edited(t) => { Cfg.f.today-city = t; Cfg.commit(); }
            }
        }
        Setting {
            title: "Satuan";
            Segmented {
                options: ["Metrik", "Imperial"];
                index: Cfg.f.today-units;
                selected(i) => { Cfg.f.today-units = i; Cfg.commit(); }
            }
        }
    }

    SectionLabel { text: "JADWAL SHOLAT"; }
    Card {
        Setting {
            first: true;
            title: "Nama kota";
            Field {
                width: 200px;
                text: Cfg.f.prayer-city;
                edited(t) => { Cfg.f.prayer-city = t; Cfg.commit(); }
            }
        }
        Setting {
            title: "Lintang";
            subtitle: Cfg.problems.prayer-lat != "" ? Cfg.problems.prayer-lat : "-90 sampai 90, contoh -6.2088";
            Field {
                width: 120px;
                mono: true;
                text: Cfg.f.prayer-lat;
                invalid: Cfg.problems.prayer-lat != "";
