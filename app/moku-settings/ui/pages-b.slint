            FeatureTile {
                glyph: "\u{EC4F}"; tint: #ff5a5f; title: "Musik & lirik"; subtitle: "Kontrol pemutar dan lirik berjalan";
                checked: Cfg.f.media-enabled;
                toggled(v) => { Cfg.f.media-enabled = v; Cfg.commit(); }
            }
            FeatureTile {
                glyph: "\u{EA8F}"; tint: #0a84ff; title: "Notifikasi"; subtitle: "Dari mokuctl dan skrip, tampil di island";
                checked: Cfg.f.ipc-enabled;
                toggled(v) => { Cfg.f.ipc-enabled = v; Cfg.commit(); }
            }
        }
        Row {
            FeatureTile {
                glyph: "\u{EC59}"; tint: #8e5cf2; title: "Shelf"; subtitle: "Simpan file sementara dengan seret-lepas";
                checked: Cfg.f.shelf-enabled;
                toggled(v) => { Cfg.f.shelf-enabled = v; Cfg.commit(); }
            }
            FeatureTile {
                glyph: "\u{E77F}"; tint: #2fb99a; title: "Riwayat clipboard"; subtitle: "Teks dan gambar yang baru disalin";
                checked: Cfg.f.clipboard-enabled;
                toggled(v) => { Cfg.f.clipboard-enabled = v; Cfg.commit(); }
            }
        }
        Row {
            FeatureTile {
