                edited(v) => { Cfg.f.timer-focus = v; Cfg.commit(); }
            }
        }
        Setting {
            title: "Timer: lama istirahat";
            Stepper {
                minimum: 1; maximum: 60; step: 1; suffix: " menit";
                value: Cfg.f.timer-break;
                edited(v) => { Cfg.f.timer-break = v; Cfg.commit(); }
            }
        }
        Setting {
            title: "Tangkap layar: salin ke clipboard";
            Toggle {
                checked: Cfg.f.capture-copy;
                toggled(v) => { Cfg.f.capture-copy = v; Cfg.commit(); }
            }
        }
        Setting {
            title: "Tangkap layar: folder simpan";
            subtitle: "Kosong = Pictures\\Moku";
            Field {
                width: 260px;
                placeholder: "Pictures\\Moku";
                text: Cfg.f.capture-save-dir;
                edited(t) => { Cfg.f.capture-save-dir = t; Cfg.commit(); }
            }
        }
    }

    PowerSettings { }

    SectionLabel { text: "HARI INI & CUACA"; }
    Card {
        ToggleSetting {
            first: true;
            title: "Tampilkan cuaca";
            subtitle: "Dari Open-Meteo, hanya saat fitur ini menyala";
            checked: Cfg.f.today-weather;
            toggled(v) => { Cfg.f.today-weather = v; Cfg.commit(); }
        }
