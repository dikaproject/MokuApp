            }
            FeatureTile {
                glyph: "\u{E767}"; tint: #0a84ff; title: "Indikator volume"; subtitle: "Pil sesaat saat volume berubah";
                checked: Cfg.f.volume-osd-enabled;
                toggled(v) => { Cfg.f.volume-osd-enabled = v; Cfg.commit(); }
            }
        }
        Row {
            FeatureTile {
                glyph: "\u{E943}"; tint: #f0a02a; title: "Izin AI coding"; subtitle: "Kartu izin untuk Claude Code dan agen lain";
                checked: Cfg.f.ipc-ai-cards;
                toggled(v) => { Cfg.f.ipc-ai-cards = v; Cfg.commit(); }
            }
            FeatureTile {
                glyph: "\u{E753}"; tint: #0a84ff; title: "Pengingat minum"; subtitle: "Pengingat kesehatan berkala";
                checked: Cfg.f.reminders-water;
                toggled(v) => { Cfg.f.reminders-water = v; Cfg.commit(); }
            }
        }
        Row {
            FeatureTile {
                glyph: "\u{E890}"; tint: #8e5cf2; title: "Istirahat mata"; subtitle: "Pengingat 20-20-20";
                checked: Cfg.f.reminders-eye;
                toggled(v) => { Cfg.f.reminders-eye = v; Cfg.commit(); }
            }
            FeatureTile {
                glyph: "\u{E708}"; tint: #f0a02a; title: "Jadwal sholat"; subtitle: "Modul regional, bisa dimatikan";
                checked: Cfg.f.prayer-enabled;
