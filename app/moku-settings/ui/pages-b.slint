            }
        }
        Setting {
            title: "Bujur";
            subtitle: Cfg.problems.prayer-lon != "" ? Cfg.problems.prayer-lon : "-180 sampai 180, contoh 106.8456";
            Field {
                width: 120px;
                mono: true;
                text: Cfg.f.prayer-lon;
                invalid: Cfg.problems.prayer-lon != "";
                edited(t) => { Cfg.f.prayer-lon = t; Cfg.commit(); }
            }
        }
        Setting {
            title: "Ingatkan sebelum waktu sholat";
