                checked: Cfg.f.timer-enabled;
                toggled(v) => { Cfg.f.timer-enabled = v; Cfg.commit(); }
            }
        }
        Row {
            FeatureTile {
                glyph: "\u{E9D9}"; tint: #2fb99a; title: "Monitor sistem"; subtitle: "CPU, RAM, GPU, disk, jaringan";
                checked: Cfg.f.monitor-enabled;
                toggled(v) => { Cfg.f.monitor-enabled = v; Cfg.commit(); }
            }
            FeatureTile {
                glyph: "\u{E9E9}"; tint: #5e6ef0; title: "Panel kontrol"; subtitle: "Wi-Fi, Bluetooth, volume, kecerahan";
                checked: Cfg.f.control-enabled;
                toggled(v) => { Cfg.f.control-enabled = v; Cfg.commit(); }
