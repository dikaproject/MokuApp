// ---------------------------------------------------------------- Notifikasi

export component NotifikasiPage inherits Page {
    title: "Notifikasi";
    subtitle: "Cara pemberitahuan tampil di island, pil sistem, dan pengingat.";

    SectionLabel { text: "TAMPILAN"; }
    Card {
        ToggleSetting {
            first: true;
            title: "Tampilkan notifikasi di island";
            subtitle: "Pesan dari mokuctl dan skrip lain";
            checked: Cfg.f.ipc-enabled;
            toggled(v) => { Cfg.f.ipc-enabled = v; Cfg.commit(); }
        }
        ToggleSetting {
            title: "Kartu izin AI coding";
            subtitle: "Setujui atau tolak perintah agen lewat mokuctl ask";
            checked: Cfg.f.ipc-ai-cards;
            toggled(v) => { Cfg.f.ipc-ai-cards = v; Cfg.commit(); }
        }
        Setting {
            title: "Riwayat notifikasi";
            subtitle: "Jumlah maksimum yang disimpan di panel Notifikasi";
            Stepper {
                minimum: 1; maximum: 500; step: 10; suffix: " item";
                value: Cfg.f.ipc-max-notifications;
                edited(v) => { Cfg.f.ipc-max-notifications = v; Cfg.commit(); }
            }
        }
    }

    ClaudeSection { }
    AgentsSection { }
    MirrorSection { }

    SectionLabel { text: "JANGAN GANGGU"; }
    Card {
        ToggleSetting {
            first: true;
            title: "Tahan notifikasi saat mode fokus";
            subtitle: "Notifikasi baru muncul setelah fokus selesai";
            checked: Cfg.f.timer-hold;
            toggled(v) => { Cfg.f.timer-hold = v; Cfg.commit(); }
        }
        ToggleSetting {
            title: "Sembunyikan isi notifikasi saat rapat";
            subtitle: "Hanya judulnya yang tampil ketika layar dibagikan";
            checked: Cfg.f.privacy-hide-body;
            toggled(v) => { Cfg.f.privacy-hide-body = v; Cfg.commit(); }
        }
    }

    SectionLabel { text: "PIL SISTEM"; }
    Card {
        ToggleSetting {
            first: true;
            title: "Baterai";
            subtitle: "Baterai hampir habis dan sedang mengisi";
            checked: Cfg.f.system-battery;
            toggled(v) => { Cfg.f.system-battery = v; Cfg.commit(); }
        }
        ToggleSetting {
            title: "Caps Lock";
            checked: Cfg.f.system-caps-lock;
            toggled(v) => { Cfg.f.system-caps-lock = v; Cfg.commit(); }
        }
        ToggleSetting {
            title: "Internet";
            subtitle: "Putus dan tersambung kembali";
            checked: Cfg.f.system-network;
            toggled(v) => { Cfg.f.system-network = v; Cfg.commit(); }
        }
        ToggleSetting {
            title: "Titik privasi";
            subtitle: "Penanda saat kamera atau mikrofon dipakai";
            checked: Cfg.f.system-privacy-dots;
            toggled(v) => { Cfg.f.system-privacy-dots = v; Cfg.commit(); }
        }
        ToggleSetting {
            title: "Mode rapat";
            subtitle: "Tombol bisukan mikrofon saat rapat berjalan";
            checked: Cfg.f.system-meeting-mode;
            toggled(v) => { Cfg.f.system-meeting-mode = v; Cfg.commit(); }
        }
    }

    SectionLabel { text: "PENGINGAT"; }
    Card {
        ToggleSetting {
            first: true;
            title: "Pengingat minum";
            checked: Cfg.f.reminders-water;
            toggled(v) => { Cfg.f.reminders-water = v; Cfg.commit(); }
        }
        Setting {
            title: "Selang waktu minum";
            Stepper {
                minimum: 5; maximum: 480; step: 5; suffix: " menit";
                value: Cfg.f.reminders-water-interval;
                edited(v) => { Cfg.f.reminders-water-interval = v; Cfg.commit(); }
            }
        }
        Setting {
            title: "Target minum per hari";
            Stepper {
                minimum: 1; maximum: 30; step: 1; suffix: " gelas";
                value: Cfg.f.reminders-water-target;
                edited(v) => { Cfg.f.reminders-water-target = v; Cfg.commit(); }
            }
        }
        ToggleSetting {
            title: "Istirahat mata";
            checked: Cfg.f.reminders-eye;
            toggled(v) => { Cfg.f.reminders-eye = v; Cfg.commit(); }
        }
        Setting {
            title: "Selang waktu istirahat mata";
            Stepper {
                minimum: 5; maximum: 240; step: 5; suffix: " menit";
                value: Cfg.f.reminders-eye-interval;
                edited(v) => { Cfg.f.reminders-eye-interval = v; Cfg.commit(); }
            }
        }
    }
}

// ---------------------------------------------------------------- Moku Link

export component MokuLinkPage inherits Page {
    title: "Moku Link";
    subtitle: "HP yang tersambung dan apa saja yang diterima dari HP.";

    Rectangle {
        height: 200px;
        background: Theme.card;
        border-radius: 18px;
        border-width: 1px;
        border-color: Theme.line;
        VerticalLayout {
            alignment: center;
            spacing: 10px;
            HorizontalLayout {
                alignment: center;
                IconTile { glyph: "\u{E8EA}"; tint: #2b7bef; size: 46px; }
            }
            HorizontalLayout {
                alignment: center;
                Text { text: "Segera hadir"; font-size: 18px; font-weight: 700; color: Theme.text; }
            }
            HorizontalLayout {
                alignment: center;
                Text {
                    width: 420px;
                    text: "Notifikasi, panggilan, dan kode OTP dari HP akan muncul di island lewat aplikasi pendamping Android. Aplikasinya belum tersedia di versi 0.1.";
                    font-size: 12.5px;
                    color: Theme.text2;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
