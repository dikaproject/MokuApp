import { Theme } from "theme.slint";

// A glyph from Segoe Fluent Icons / Segoe MDL2 Assets.
export component Glyph inherits Text {
    in property <string> g;
    text: g;
    font-family: Theme.icons;
    font-size: 15px;
    color: Theme.text;
    horizontal-alignment: center;
    vertical-alignment: center;
}

export component Toggle inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 44px;
    height: 26px;
    border-radius: 13px;
    background: root.checked ? Theme.green : #ffffff38;
    opacity: root.enabled ? 1.0 : 0.45;
    animate background { duration: 120ms; }
    Rectangle {
        y: 3px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: #ffffff;
        x: root.checked ? root.width - self.width - 3px : 3px;
        animate x { duration: 120ms; easing: ease-out; }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }
}

export component Btn inherits Rectangle {
    in property <string> text;
    // normal | primary (white) | accent | danger
    in property <string> kind: "normal";
    in property <bool> enabled: true;
    callback clicked();
    height: 30px;
    min-width: 30px;
    border-radius: 15px;
    // danger: red text on a clear red tint with a thin red edge, so "Hapus" reads as an enabled
    // destructive button (the old 18 % tint and dull red looked disabled).
    background: root.kind == "primary" ? #ffffff
        : root.kind == "accent" ? Theme.blue
        : root.kind == "danger" ? #ff453a3d
        : Theme.fill2;
    border-width: root.kind == "danger" ? 1px : 0px;
    border-color: #ff453a73;
    opacity: root.enabled ? 1.0 : 0.45;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.text;
            font-size: 12.5px;
            font-weight: 600;
            vertical-alignment: center;
            color: root.kind == "primary" ? Theme.ink : root.kind == "danger" ? #ff9a92 : #ffffff;
        }
    }
    Rectangle {
        background: ta.has-hover && root.enabled ? #ffffff14 : transparent;
        border-radius: root.border-radius;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Pill-shaped options; index -1 selects nothing.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> index;
    callback selected(int);
    height: 30px;
    border-radius: 15px;
    background: #ffffff10;
    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for o[i] in root.options: Rectangle {
            border-radius: 12px;
            background: i == root.index ? #ffffff38 : transparent;
            animate background { duration: 100ms; }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                Text {
                    text: o;
                    font-size: 12px;
                    font-weight: i == root.index ? 600 : 400;
                    color: i == root.index ? Theme.text : Theme.text2;
                    vertical-alignment: center;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.selected(i); }
            }
        }
    }
}

export component Slide inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> value;
    in property <float> step: 1;
    callback edited(float);
    width: 190px;
    height: 24px;
    property <float> frac: (root.value - root.minimum) / (root.maximum - root.minimum);
    function pick(x: length) {
        let f = Math.max(0.0, Math.min(1.0, (x - 9px) / (root.width - 18px)));
        let raw = root.minimum + f * (root.maximum - root.minimum);
        root.edited(Math.round(raw / root.step) * root.step);
    }
    Rectangle {
        y: (root.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        background: #ffffff2e;
        Rectangle {
            x: 0;
            width: 9px + root.frac * (root.width - 18px);
            border-radius: 2px;
            background: Theme.accent;
        }
    }
    Rectangle {
        x: root.frac * (root.width - 18px);
        y: (root.height - 18px) / 2;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: #ffffff;
    }
    TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                root.pick(self.mouse-x);
            }
        }
        moved => { root.pick(self.mouse-x); }
    }
}

// - value +
export component Stepper inherits Rectangle {
    in property <int> value;
    in property <int> minimum;
    in property <int> maximum;
    in property <int> step: 1;
    in property <string> suffix;
    callback edited(int);
    height: 30px;
    border-radius: 15px;
    background: #ffffff10;
    HorizontalLayout {
        padding: 3px;
        spacing: 0px;
        Rectangle {
            width: 24px;
            border-radius: 12px;
            background: dec.has-hover ? #ffffff1c : transparent;
            opacity: root.value > root.minimum ? 1.0 : 0.35;
            Text { text: "\u{2212}"; font-size: 15px; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; }
            dec := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.edited(Math.max(root.minimum, root.value - root.step)); }
            }
        }
        Rectangle {
            min-width: 62px;
            Text {
                text: root.value + root.suffix;
                font-size: 12.5px;
                font-weight: 600;
                color: Theme.text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Rectangle {
            width: 24px;
            border-radius: 12px;
            background: inc.has-hover ? #ffffff1c : transparent;
            opacity: root.value < root.maximum ? 1.0 : 0.35;
            Text { text: "+"; font-size: 15px; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; }
            inc := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.edited(Math.min(root.maximum, root.value + root.step)); }
            }
        }
    }
}

// Single-line text input in a rounded box.
export component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> invalid: false;
    in property <bool> mono: false;
    in property <bool> read-only: false;
    callback edited(string);
    height: 30px;
    width: 220px;
    border-radius: 10px;
    background: #00000033;
    border-width: 1px;
    border-color: root.invalid ? Theme.red : ti.has-focus ? Theme.accent : #ffffff1f;
    ti := TextInput {
        x: 10px;
        width: root.width - 20px;
        height: root.height;
        vertical-alignment: center;
        font-size: 12.5px;
        font-family: root.mono ? "Consolas" : Theme.font;
        color: Theme.text;
        selection-background-color: #0a84ff99;
        wrap: no-wrap;
        read-only: root.read-only;
        text <=> root.text;
        edited => { root.edited(self.text); }
    }
    if root.text == "" && !ti.has-focus: Text {
        x: 10px;
        text: root.placeholder;
        font-size: 12.5px;
        color: Theme.text3;
        vertical-alignment: center;
        height: root.height;
    }
}

export component SectionLabel inherits Rectangle {
    in property <string> text;
    height: 32px;
    Text {
        width: root.width;
        height: root.height - 4px;
        text: root.text;
        font-size: 10.5px;
        font-weight: 600;
        color: Theme.text3;
        letter-spacing: 0.6px;
        vertical-alignment: bottom;
    }
}

// A rounded group of rows.
export component Card inherits Rectangle {
    background: Theme.card;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.line;
    VerticalLayout {
        @children
    }
}

// One setting row: title (+ optional subtitle) on the left, the control(s) on the right.
// (Not called Row: that is the grid-layout keyword.)
export component Setting inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    // The first row of a card has no divider above it.
    in property <bool> first: false;
    min-height: 52px;
    if !root.first: Rectangle {
        y: 0;
        height: 1px;
        background: Theme.line;
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 14px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                font-size: 13.5px;
                font-weight: 500;
                color: Theme.text;
                wrap: word-wrap;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                font-size: 11.5px;
                color: Theme.text3;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 8px;
                @children
            }
        }
    }
}

export component ToggleSetting inherits Setting {
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    Toggle {
        checked: root.checked;
        enabled: root.enabled;
        toggled(v) => { root.toggled(v); }
    }
}

// Page frame: title, subtitle, scrolling body.
export component Page inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    property <length> total: body.preferred-height + 50px;
    // Thin scroll indicator on the right edge, only when the page is taller than the window.
    if root.total > root.height: Rectangle {
        x: root.width - 7px;
        y: 6px + (-fl.content-y / root.total) * (root.height - 12px);
        width: 3px;
        height: Math.max(24px, (root.height / root.total) * (root.height - 12px));
        border-radius: 1.5px;
        background: #ffffff33;
    }
    fl := Flickable {
        // Debug flag --scroll: start scrolled down (screenshots of long pages).
        content-y: -Theme.start-scroll;
        content-width: root.width;
        content-height: root.total;
        body := VerticalLayout {
            alignment: start;
            x: 28px;
            y: 22px;
            width: root.width - 56px;
            spacing: 8px;
            Text { text: root.title; font-size: 24px; font-weight: 700; color: Theme.text; }
            Text { text: root.subtitle; font-size: 12.5px; color: Theme.text2; wrap: word-wrap; }
            Rectangle { height: 6px; }
            @children
        }
    }
}

// Coloured rounded square with a glyph (feature tiles, onboarding rows).
export component IconTile inherits Rectangle {
    in property <string> glyph;
    in property <color> tint: Theme.blue;
    in property <length> size: 32px;
    width: root.size;
    height: root.size;
    border-radius: root.size * 0.3;
    background: root.tint;
    Glyph { g: root.glyph; font-size: root.size * 0.5; color: #ffffff; }
}

export component Kbd inherits Rectangle {
    in property <string> text;
    height: 22px;
    border-radius: 6px;
    background: Theme.fill3;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text { text: root.text; font-size: 11px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
    }
}

// Small status pill ("segera hadir").
export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.orange;
    height: 20px;
    border-radius: 10px;
    background: transparent;
    border-width: 1px;
    border-color: root.tint;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text { text: root.text; font-size: 10.5px; font-weight: 600; color: root.tint; vertical-alignment: center; }
    }
}

// The island's idle mark: the gradient "m on a waterline" (same geometry as `Gfx::logo` in the
// island, viewbox 0-100).
export component MokuMark inherits Path {
    in property <float> k: 1.0;
    width: 20px * root.k;
    height: 20px * root.k;
    viewbox-width: 100;
    viewbox-height: 100;
    commands: "M 10 70 L 25 70 L 25 51 A 12.5 12.5 0 0 1 50 51 L 50 70 L 50 51 A 12.5 12.5 0 0 1 75 51 L 75 70 L 90 70";
    stroke: @linear-gradient(90deg, #4fd8ff 0%, #7c6bff 50%, #ff5fa2 100%);
    stroke-width: 1.9px * root.k;
    stroke-line-cap: round;
    fill: transparent;
}

// Fake island pill shared by the previews: the idle mark + clock (as the island shows it).
export component MiniPill inherits Rectangle {
    in property <color> tint: #0b0b14d6;
    in property <color> accent: Theme.accent;
    in property <float> k: 1.0;
    in property <string> text: "10.24";
    // Notch style: flat on top, attached to the screen edge.
    in property <bool> notch: false;
    width: 92px * root.k;
    height: 30px * root.k;
    border-radius: self.height / 2;
    border-top-left-radius: root.notch ? 0px : self.height / 2;
    border-top-right-radius: root.notch ? 0px : self.height / 2;
    background: root.tint;
    border-width: 1px;
    border-color: #ffffff2e;
    HorizontalLayout {
        alignment: center;
        spacing: 7px * root.k;
        VerticalLayout {
            alignment: center;
            MokuMark { k: root.k; }
        }
        Text { text: root.text; font-size: 12.5px * root.k; font-weight: 600; color: #ffffff; vertical-alignment: center; }
    }
}
