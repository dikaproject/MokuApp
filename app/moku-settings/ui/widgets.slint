import { Theme } from "theme.slint";

// The building blocks of every page. All colours, sizes and radii come from Theme (see the design
// note at the top of theme.slint): one accent, everything else grey, flat surfaces, 1 px borders.

// A glyph from Segoe Fluent Icons / Segoe MDL2 Assets: monochrome, in the secondary grey.
export component Glyph inherits Text {
    in property <string> g;
    text: g;
    font-family: Theme.icons;
    font-size: 15px;
    color: Theme.text2;
    horizontal-alignment: center;
    vertical-alignment: center;
}

export component Toggle inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 40px;
    height: 24px;
    border-radius: 12px;
    background: root.checked ? Theme.accent : Theme.control-hi;
    border-width: 1px;
    border-color: root.checked ? Theme.accent : Theme.line-strong;
    opacity: root.enabled ? 1.0 : 0.45;
    animate background { duration: 120ms; }
    // ON: the knob sits on the right, OFF: on the left (so the state does not rely on colour).
    Rectangle {
        y: 3px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.checked ? Theme.knob : Theme.text2;
        x: root.checked ? root.width - self.width - 5px : 3px;
        animate x { duration: 120ms; easing: ease-out; }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }
}

export component Btn inherits Rectangle {
    in property <string> text;
    // normal | primary (accent) | accent (same as primary) | danger (outlined red)
    in property <string> kind: "normal";
    in property <bool> enabled: true;
    callback clicked();
    height: 32px;
    min-width: 32px;
    border-radius: Theme.radius-ctl;
    background: root.kind == "primary" || root.kind == "accent" ? Theme.accent
        : root.kind == "danger" ? transparent
        : Theme.control;
    border-width: 1px;
    border-color: root.kind == "primary" || root.kind == "accent" ? Theme.accent
        : root.kind == "danger" ? Theme.danger.with-alpha(0.6)
        : Theme.line-strong;
    opacity: root.enabled ? 1.0 : 0.45;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        Text {
            text: root.text;
            font-size: Theme.fs-body;
            font-weight: root.kind == "primary" || root.kind == "accent" ? Theme.fw-bold : Theme.fw-regular;
            vertical-alignment: center;
            color: root.kind == "primary" || root.kind == "accent" ? Theme.on-accent
                : root.kind == "danger" ? Theme.danger
                : Theme.text;
        }
    }
    // Hover: a lighter fill (a red wash for danger), only while it can be pressed.
    Rectangle {
        background: ta.has-hover && root.enabled ? (root.kind == "danger" ? Theme.danger.with-alpha(0.12) : #ffffff1a) : transparent;
        border-radius: root.border-radius;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Options in one box; the selected one has the accent wash, an accent edge and semibold text.
// Index -1 selects nothing.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> index;
    callback selected(int);
    height: 32px;
    border-radius: Theme.radius-ctl;
    background: Theme.control;
    border-width: 1px;
    border-color: Theme.line;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for o[i] in root.options: Rectangle {
            border-radius: Theme.radius-inner;
            background: i == root.index ? Theme.accent-soft : seg-ta.has-hover ? #ffffff10 : transparent;
            border-width: 1px;
            border-color: i == root.index ? Theme.accent-line : transparent;
            animate background { duration: 100ms; }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                Text {
                    text: o;
                    font-size: Theme.fs-small;
                    font-weight: i == root.index ? Theme.fw-bold : Theme.fw-regular;
                    color: i == root.index ? Theme.text : Theme.text2;
                    vertical-alignment: center;
                }
            }
            seg-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.selected(i); }
            }
        }
    }
}

export component Slide inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> value;
    in property <float> step: 1;
    callback edited(float);
    width: 192px;
    height: 24px;
    property <float> frac: (root.value - root.minimum) / (root.maximum - root.minimum);
    function pick(x: length) {
        let f = Math.max(0.0, Math.min(1.0, (x - 8px) / (root.width - 16px)));
        let raw = root.minimum + f * (root.maximum - root.minimum);
        root.edited(Math.round(raw / root.step) * root.step);
    }
    Rectangle {
        y: (root.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.control-hi;
        Rectangle {
            x: 0;
            width: 8px + root.frac * (root.width - 16px);
            border-radius: 2px;
            background: Theme.accent;
        }
    }
    Rectangle {
        x: root.frac * (root.width - 16px);
        y: (root.height - 16px) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: Theme.text;
        border-width: 1px;
        border-color: Theme.line-strong;
    }
    TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                root.pick(self.mouse-x);
            }
        }
        moved => { root.pick(self.mouse-x); }
    }
}

// A thin progress bar (downloads): the accent on a grey track.
export component Progress inherits Rectangle {
    // 0..1
    in property <float> value;
    height: 4px;
    border-radius: 2px;
    background: Theme.control-hi;
    Rectangle {
        x: 0;
        width: parent.width * Math.max(0.0, Math.min(1.0, root.value));
        border-radius: 2px;
        background: Theme.accent;
    }
}

// - value +
export component Stepper inherits Rectangle {
    in property <int> value;
    in property <int> minimum;
    in property <int> maximum;
    in property <int> step: 1;
    in property <string> suffix;
    callback edited(int);
    height: 32px;
    border-radius: Theme.radius-ctl;
    background: Theme.control;
    border-width: 1px;
    border-color: Theme.line-strong;
    HorizontalLayout {
        padding: 2px;
        spacing: 0px;
        Rectangle {
            width: 28px;
            border-radius: Theme.radius-inner;
            background: dec.has-hover && root.value > root.minimum ? Theme.control-hi : transparent;
            opacity: root.value > root.minimum ? 1.0 : 0.4;
            Text { text: "\u{2212}"; font-size: 15px; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; }
            dec := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.edited(Math.max(root.minimum, root.value - root.step)); }
            }
        }
        Rectangle {
            min-width: 64px;
            Text {
                text: root.value + root.suffix;
                font-size: Theme.fs-body;
                font-weight: Theme.fw-bold;
                color: Theme.text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Rectangle {
            width: 28px;
            border-radius: Theme.radius-inner;
            background: inc.has-hover && root.value < root.maximum ? Theme.control-hi : transparent;
            opacity: root.value < root.maximum ? 1.0 : 0.4;
            Text { text: "+"; font-size: 15px; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; }
            inc := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.edited(Math.min(root.maximum, root.value + root.step)); }
            }
        }
    }
}

// Single-line text input: an inset box; the accent outline while it has focus, red when invalid.
export component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> invalid: false;
    in property <bool> mono: false;
    in property <bool> read-only: false;
    callback edited(string);
    height: 32px;
    width: 224px;
    border-radius: Theme.radius-ctl;
    background: Theme.bg;
    border-width: root.invalid || ti.has-focus ? 2px : 1px;
    border-color: root.invalid ? Theme.danger : ti.has-focus ? Theme.accent : Theme.line-strong;
    ti := TextInput {
        x: 10px;
        width: root.width - 20px;
        height: root.height;
        vertical-alignment: center;
        font-size: Theme.fs-body;
        font-family: root.mono ? "Consolas" : Theme.font;
        color: Theme.text;
        selection-background-color: Theme.accent-line;
        wrap: no-wrap;
        read-only: root.read-only;
        text <=> root.text;
        edited => { root.edited(self.text); }
    }
    if root.text == "" && !ti.has-focus: Text {
        x: 10px;
        text: root.placeholder;
        font-size: Theme.fs-body;
        color: Theme.text3;
        vertical-alignment: center;
        height: root.height;
    }
}

// A section title: sentence case, small, secondary grey, semibold.
export component SectionLabel inherits Rectangle {
    in property <string> text;
    height: 32px;
    Text {
        width: root.width;
        height: root.height - 4px;
        text: root.text;
        font-size: Theme.fs-small;
        font-weight: Theme.fw-bold;
        color: Theme.text2;
        vertical-alignment: bottom;
    }
}

// A group of rows on the card surface, with a 1 px border and no shadow.
export component Card inherits Rectangle {
    background: Theme.card;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.line;
    VerticalLayout {
        @children
    }
}

// One setting row: title (+ optional subtitle) on the left, the control(s) on the right.
// (Not called Row: that is the grid-layout keyword.)
export component Setting inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    // The first row of a card has no divider above it.
    in property <bool> first: false;
    in property <color> subtitle-color: Theme.text3;
    min-height: 56px;
    if !root.first: Rectangle {
        y: 0;
        height: 1px;
        background: Theme.line;
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                font-size: Theme.fs-body;
                color: Theme.text;
                wrap: word-wrap;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                font-size: Theme.fs-small;
                color: root.subtitle-color;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 8px;
                @children
            }
        }
    }
}

export component ToggleSetting inherits Setting {
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    Toggle {
        checked: root.checked;
        enabled: root.enabled;
        toggled(v) => { root.toggled(v); }
    }
}

// Page frame: title, subtitle, scrolling body.
export component Page inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    property <length> total: body.preferred-height + 56px;
    // Thin scroll indicator on the right edge, only when the page is taller than the window.
    if root.total > root.height: Rectangle {
        x: root.width - 7px;
        y: 6px + (-fl.content-y / root.total) * (root.height - 12px);
        width: 3px;
        height: Math.max(24px, (root.height / root.total) * (root.height - 12px));
        border-radius: 1.5px;
        background: Theme.line-strong;
    }
    fl := Flickable {
        // Debug flag --scroll: start scrolled down (screenshots of long pages).
        content-y: -Theme.start-scroll;
        content-width: root.width;
        content-height: root.total;
        body := VerticalLayout {
            alignment: start;
            x: 32px;
            y: 24px;
            width: root.width - 64px;
            spacing: 8px;
            Text { text: root.title; font-size: Theme.fs-title; font-weight: Theme.fw-bold; color: Theme.text; }
            Text { text: root.subtitle; font-size: Theme.fs-body; color: Theme.text2; wrap: word-wrap; }
            Rectangle { height: 8px; }
            @children
        }
    }
}

// A neutral square with a monochrome glyph (feature tiles, onboarding rows).
export component IconTile inherits Rectangle {
    in property <string> glyph;
    in property <length> size: 32px;
    width: root.size;
    height: root.size;
    border-radius: Theme.radius-ctl;
    background: Theme.control;
    border-width: 1px;
    border-color: Theme.line;
    Glyph { g: root.glyph; font-size: root.size * 0.5; color: Theme.text2; }
}

export component Kbd inherits Rectangle {
    in property <string> text;
    height: 24px;
    border-radius: Theme.radius-inner;
    background: Theme.control;
    border-width: 1px;
    border-color: Theme.line-strong;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text { text: root.text; font-size: Theme.fs-caption; font-weight: Theme.fw-bold; color: Theme.text; vertical-alignment: center; }
    }
}

// A small neutral outlined tag ("segera").
export component Badge inherits Rectangle {
    in property <string> text;
    height: 20px;
    border-radius: Theme.radius-inner;
    background: transparent;
    border-width: 1px;
    border-color: Theme.line-strong;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text { text: root.text; font-size: Theme.fs-caption; color: Theme.text3; vertical-alignment: center; }
    }
}

// The island's idle mark: the gradient "m on a waterline" (same geometry as `Gfx::logo` in the
// island, viewbox 0-100). The brand gradient lives only here and in the logo image.
export component MokuMark inherits Path {
    in property <float> k: 1.0;
    width: 20px * root.k;
    height: 20px * root.k;
    viewbox-width: 100;
    viewbox-height: 100;
    commands: "M 10 70 L 25 70 L 25 51 A 12.5 12.5 0 0 1 50 51 L 50 70 L 50 51 A 12.5 12.5 0 0 1 75 51 L 75 70 L 90 70";
    stroke: @linear-gradient(90deg, #4fd8ff 0%, #7c6bff 50%, #ff5fa2 100%);
    stroke-width: 1.9px * root.k;
    stroke-line-cap: round;
    fill: transparent;
}

// Fake island pill shared by the previews: the idle mark + clock (as the island shows it).
export component MiniPill inherits Rectangle {
    in property <color> tint: #0b0b14d6;
    in property <color> accent: Theme.accent;
    in property <float> k: 1.0;
    in property <string> text: "10.24";
    // Notch style: flat on top, attached to the screen edge.
    in property <bool> notch: false;
    width: 92px * root.k;
    height: 30px * root.k;
    border-radius: self.height / 2;
    border-top-left-radius: root.notch ? 0px : self.height / 2;
    border-top-right-radius: root.notch ? 0px : self.height / 2;
    background: root.tint;
    border-width: 1px;
    border-color: #ffffff2e;
    HorizontalLayout {
        alignment: center;
        spacing: 7px * root.k;
        VerticalLayout {
            alignment: center;
            MokuMark { k: root.k; }
        }
        Text { text: root.text; font-size: 12.5px * root.k; font-weight: 600; color: #ffffff; vertical-alignment: center; }
    }
}
