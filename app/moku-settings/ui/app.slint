import { Cfg } from "cfg.slint";
import { Theme } from "theme.slint";
import { Form, Problems } from "form.slint";
import { Btn, Glyph, Badge } from "widgets.slint";
import { UmumPage, IslandPage, TampilanPage } from "pages-a.slint";
import { FiturPage, NotifikasiPage, MokuLinkPage } from "pages-b.slint";
import { PintasanPage, PluginPage, PrivasiPage, TentangPage } from "pages-c.slint";
import { Onboarding } from "onboarding.slint";
export { ClaudeCfg } from "pages-g.slint";
import { CalendarCfg, CalUrl } from "pages-j.slint";
import { PowerCfg } from "pages-h.slint";
import { AiPage, MemoriPage } from "pages-m.slint";

export { Cfg, Theme, Form, Problems, CalendarCfg, CalUrl, PowerCfg }
export { LauncherCfg } from "pages-k.slint";
export { PlacementCfg } from "pages-o.slint";
export { IbadahCfg } from "pages-n.slint";
export { AgentsCfg, AgentRule, MirrorCfg, MirrorApp } from "pages-q.slint";
export { TodayCfg } from "pages-p.slint";
export { OcrCfg } from "pages-l.slint";
export { AiCfg, AiFact } from "pages-m.slint";
export { PhoneCfg } from "pages-r.slint";

struct NavEntry { glyph: string, label: string, soon: bool }

component NavItem inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> selected;
    in property <bool> soon;
    callback clicked();
    height: 36px;
    border-radius: Theme.radius-ctl;
    // Selected: the accent wash, a 3 px bar on the left AND semibold text (not colour alone).
    background: root.selected ? Theme.accent-soft : ta.has-hover ? #ffffff10 : transparent;
    if root.selected: Rectangle {
        x: 0;
        y: 8px;
        width: 3px;
        height: root.height - 16px;
        border-radius: 1.5px;
        background: Theme.accent;
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 12px;
        Glyph {
            g: root.glyph;
            font-size: 14px;
            width: 18px;
            color: root.selected ? Theme.text : Theme.text2;
        }
        Text {
            text: root.label;
            font-size: Theme.fs-body;
            font-weight: root.selected ? Theme.fw-bold : Theme.fw-regular;
            color: root.selected ? Theme.text : root.soon ? Theme.text3 : Theme.text2;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.soon: VerticalLayout {
            alignment: center;
            Badge { text: "segera"; }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Confirm inherits Rectangle {
    in property <string> title;
    in property <string> message;
    in property <string> action;
    callback accepted();
    callback cancelled();
    background: Theme.scrim;
    TouchArea { clicked => { root.cancelled(); } }
    Rectangle {
        width: 420px;
        height: dialog.preferred-height;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Theme.card;
        border-radius: Theme.radius-card;
        border-width: 1px;
        border-color: Theme.line-strong;
        TouchArea { }
        dialog := VerticalLayout {
            padding: 24px;
            spacing: 8px;
            Text { text: root.title; font-size: Theme.fs-heading; font-weight: Theme.fw-bold; color: Theme.text; wrap: word-wrap; }
            Text { text: root.message; font-size: Theme.fs-body; color: Theme.text2; wrap: word-wrap; }
            Rectangle { height: 8px; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Btn { text: "Batal"; clicked => { root.cancelled(); } }
                Btn { text: root.action; kind: "danger"; clicked => { root.accepted(); } }
            }
        }
    }
}

export component SettingsWindow inherits Window {
    title: "Moku — Pengaturan";
    icon: @image-url("../assets/logo.png");
    default-font-family: Theme.font;
    min-width: 820px;
    // 12 sidebar entries (36 px each, 3 px apart) plus the logo and the version line need about 570 px:
    // 640 leaves room, so the last entry ("Tentang") is never cut off at the smallest window.
    min-height: 640px;
    preferred-width: 1000px;
    preferred-height: 700px;
    background: Theme.bg;

    property <[NavEntry]> nav: [
        { glyph: "\u{E9E9}", label: "Umum" },
        { glyph: "\u{E7F4}", label: "Island" },
        { glyph: "\u{E790}", label: "Tampilan" },
        { glyph: "\u{E71D}", label: "Fitur" },
        { glyph: "\u{EA8F}", label: "Notifikasi" },
        { glyph: "\u{E8EA}", label: "Moku Link", soon: true },
        { glyph: "\u{E765}", label: "Pintasan" },
        { glyph: "\u{E943}", label: "Plugin" },
        { glyph: "\u{E72E}", label: "Privasi" },
        { glyph: "\u{E8BD}", label: "Tanya AI" },
        { glyph: "\u{E81C}", label: "Memori & Privasi" },
        { glyph: "\u{E946}", label: "Tentang" },
    ];

    Rectangle {
        background: Theme.window-bg;
    }

    if !Cfg.onboarding: Rectangle {
        // ---------------------------------------------------------- sidebar
        Rectangle {
            x: 0;
            width: 224px;
            background: Theme.bg;
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.line;
            }
            VerticalLayout {
                padding: 16px;
                padding-top: 24px;
                spacing: 4px;
                HorizontalLayout {
                    spacing: 12px;
                    padding-left: 4px;
                    padding-bottom: 16px;
                    VerticalLayout {
                        alignment: center;
                        Image { source: @image-url("../assets/logo.png"); width: 30px; height: 30px; }
                    }
                    Text { text: "Moku"; font-size: Theme.fs-heading; font-weight: Theme.fw-bold; color: Theme.text; vertical-alignment: center; }
                }
                for item[i] in root.nav: NavItem {
                    glyph: item.glyph;
                    label: item.label;
                    soon: item.soon;
                    selected: Cfg.page == i;
                    clicked => { Cfg.page = i; }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    padding-left: 8px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.accent; }
                    }
                    Text { text: "Moku " + Cfg.version; font-size: Theme.fs-caption; color: Theme.text3; vertical-alignment: center; }
                }
            }
        }

        // ---------------------------------------------------------- pages
        Rectangle {
            x: 224px;
            width: root.width - 224px;
            for e in [Cfg.epoch]: Rectangle {
                if Cfg.page == 0: UmumPage { }
                if Cfg.page == 1: IslandPage { }
                if Cfg.page == 2: TampilanPage { }
                if Cfg.page == 3: FiturPage { }
                if Cfg.page == 4: NotifikasiPage { }
                if Cfg.page == 5: MokuLinkPage { }
                if Cfg.page == 6: PintasanPage { }
                if Cfg.page == 7: PluginPage { }
                if Cfg.page == 8: PrivasiPage { }
                if Cfg.page == 9: AiPage { }
                if Cfg.page == 10: MemoriPage { }
                if Cfg.page == 11: TentangPage { }
            }
        }
    }

    if Cfg.onboarding: Onboarding { }

    // Saved / error messages.
    if Cfg.toast != "": Rectangle {
        width: toast-text.preferred-width + 32px;
        height: 40px;
        x: root.width - self.width - 24px;
        y: root.height - 64px;
        border-radius: Theme.radius-ctl;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.line-strong;
        toast-text := Text {
            text: Cfg.toast;
            font-size: Theme.fs-body;
            color: Theme.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if Cfg.confirm == 1: Confirm {
        title: "Hapus semua data Moku?";
        message: "Riwayat clipboard, isi Shelf, to-do, dan log di folder data akan dihapus. Pengaturanmu (config.toml) tetap ada. Tindakan ini tidak bisa dibatalkan.";
        action: "Hapus semua";
        cancelled => { Cfg.confirm = 0; }
        accepted => { Cfg.confirm = 0; Cfg.delete-data(); }
    }
    if Cfg.confirm == 2: Confirm {
        title: "Kembalikan semua pengaturan?";
        message: "Semua pengaturan kembali ke nilai awal. Data seperti riwayat clipboard dan to-do tidak disentuh.";
        action: "Kembalikan";
        cancelled => { Cfg.confirm = 0; }
        accepted => { Cfg.confirm = 0; Cfg.reset-settings(); }
    }
}
